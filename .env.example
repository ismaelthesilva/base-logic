# Environment Variables — copy to .env and fill in values

# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres connection string (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Sign JWTs — generate with: openssl rand -base64 64
JWT_SECRET="your-secret-here"

# ── Next.js ───────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"

# ── Vercel (optional, only for manual deploys) ─────────────────────────────────
# VERCEL_TOKEN=""
# VERCEL_ORG_ID=""
# VERCEL_PROJECT_ID=""
