// Minimal valid Prisma schema to allow build to succeed
// You can edit this later for your actual models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Country {
  USA
  BRAZIL
}

enum AssetType {
  STOCK
  ETF
  REIT
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  name         String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions FinanceTransaction[]
}

model Asset {
  id           String   @id @default(cuid())
  symbol       String
  name         String
  description  String?
  country      Country
  type         AssetType
  riskLevel    String?
  expenseRatio Float?
  dividendYield Float?
  currentPrice Float?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  fundamentals Fundamentals[]
  prices       AssetPrice[]

  @@unique([symbol, country])
  @@index([country, type])
  @@index([symbol])
}

model Fundamentals {
  id            String  @id @default(cuid())
  assetId       String
  year          Int
  receitaLiquida Float?
  lucroLiquido   Float?
  roe           Float?
  margemLiquida Float?
  dividaLiquida Float?
  ebitda        Float?
  dividendPercentage Float?

  asset         Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, year])
  @@index([year])
}

model AssetPrice {
  id      String @id @default(cuid())
  assetId String
  year    Int
  price   Float?

  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, year])
  @@index([year])
}

model Share {
  id             String   @id @default(cuid())
  symbol         String   @unique
  name           String
  sector         String?
  receitaLiquida Float?
  lucroLiquido   Float?
  roe            Float?
  margemLiquida  Float?
  debitEbitda    Float?
  ebitda         Float?
  dividendo      Float?
  passesFilter   Boolean  @default(false)
  period         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FinanceTransaction {
  id        String   @id @default(cuid())
  // Nullable for migration compatibility with pre-auth records.
  // New records always include userId (enforced at the application layer).
  // Run: npm run db:migrate after this schema change.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  date      DateTime
  category  String   @default("Expense")
  tag       String
  title     String
  currency  String   @default("USD")
  amount    Float
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
  @@index([tag])
  @@index([date])
  @@index([category])
}
