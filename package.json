{
  "name": "isma-base-logic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "dev:all": "concurrently \"npm run dev:next\" \"npm run dev:test\"",
    "dev:full": "concurrently \"npm run dev:next\" \"npm run dev:studio\" \"npm run dev:test\"",
    "dev:next": "next dev",
    "dev:studio": "npx prisma studio",
    "dev:test": "concurrently -n next,test \"next dev\" \"vitest\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "lint": "npm run lint:check && npm run lint:fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:bench": "vitest bench tests/performance/",
    "test:perf": "vitest bench tests/performance/ --reporter=verbose",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate-exercises": "tsx scripts/migrate-exercises-to-db.ts",
    "db:validate-exercises": "tsx scripts/validate-exercise-standardization.ts",
    "lint:eslint:check": "eslint .",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@headlessui/react": "^2.2.9",
    "@marsidev/react-turnstile": "^1.4.0",
    "@neondatabase/serverless": "^0.9.5",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "formik": "^2.4.6",
    "jose": "^6.1.3",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.516.0",
    "next": "^16.0.0",
    "node-pg-migrate": "^8.0.4",
    "openai": "^6.3.0",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^25.2.3",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.27",
    "baseline-browser-mapping": "^2.9.10",
    "commitizen": "4.3.1",
    "concurrently": "^10.0.5",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "^29.15.0",
    "happy-dom": "^20.0.11",
    "husky": "9.1.7",
    "i": "0.3.7",
    "jsdom": "^28.0.0",
    "npm": "11.12.0",
    "postcss": "^8.5.6",
    "prettier": "^2.8.8",
    "prisma": "^6.2.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "lodash": "^4.17.21",
    "tmp": "^0.2.3",
    "minimatch": "^9.0.5"
  }
}
